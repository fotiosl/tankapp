{
  "name": "tankapp",
  "version": "1.0.0",
  "description": "Moderne, blitzschnelle Spritpreise-PWA für iOS & Desktop mit Echtzeit-Preisen via Tankerkönig (MTS-K), interaktiver Karte, Favoriten und Ersparnisrechner.",
  "keywords": [
    "spritpreise",
    "tankstellen",
    "tankerkoenig",
    "mts-k",
    "pwa",
    "react19",
    "vite",
    "tailwindcss",
    "leaflet"
  ],
  "author": "fotiosl",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
